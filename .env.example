# Copy this file to .env and fill in your values
# cp .env.example .env

# Target URL to monitor
TARGET_URL=https://example.com/coches-de-segunda-mano

# OpenRouter API key for AI price rating (optional — ratings are skipped if not set)
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: model to use (must support web search). Default: perplexity/sonar
# OPENROUTER_MODEL=perplexity/sonar

# Optional: output directories (defaults shown)
# OUTPUT_DIR=./output
# DATA_DIR=./data
# LOG_DIR=./logs
